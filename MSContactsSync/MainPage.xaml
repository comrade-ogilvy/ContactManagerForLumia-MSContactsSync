<Page
    x:Class="MSContactsSync.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MSContactsSync"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Pivot x:Name="MainPivot" Title="MS Contact Sync">

        <!-- ======== SIGN IN ======== -->
        <PivotItem Header="Sign in">
            <ScrollViewer>
                <StackPanel Margin="12,0,12,24">
                    <TextBlock Text="Microsoft Account"
                               FontSize="22" FontWeight="Bold"
                               Margin="0,16,0,16"/>

                    <Border Background="#1AFFFFFF" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                                    <!-- Custom Client ID — hidden by default -->
                            <CheckBox x:Name="ChkCustomClientId"
                                      Content="Use custom App Registration ID"
                                      FontSize="14"
                                      Foreground="#AAAAAA"
                                      Margin="0,0,0,8"
                                      Checked="ChkCustomClientId_Changed"
                                      Unchecked="ChkCustomClientId_Changed"/>

                            <StackPanel x:Name="PanelClientId"
                                        Visibility="Collapsed"
                                        Margin="0,0,0,16">
                                <TextBlock Text="App Registration Client ID"
                                           FontSize="13" Foreground="#AAAAAA"
                                           Margin="0,0,0,4"/>
                                <PasswordBox x:Name="TxtClientId"
                                             FontSize="16"
                                             Margin="0,0,0,4"/>
                                <TextBlock Text="Leave blank to use built-in ID"
                                           FontSize="12" Foreground="#666666"/>
                            </StackPanel>

                            <Button x:Name="BtnSignIn"
                                    Content="Sign in with Microsoft"
                                    HorizontalAlignment="Stretch"
                                    Height="72" FontSize="18"
                                    Click="BtnSignIn_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Device code panel -->
                    <Border x:Name="PanelCode"
                            Background="#222222" Padding="16"
                            Visibility="Collapsed" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Open this URL in a browser:"
                                       FontSize="14" TextWrapping="Wrap"
                                       Margin="0,0,0,8"/>
                            <TextBlock x:Name="TxtVerificationUrl"
                                       FontSize="14" Foreground="#0088FF"
                                       TextWrapping="Wrap" Margin="0,0,0,16"/>
                            <TextBlock Text="Enter this code:"
                                       FontSize="14" Margin="0,0,0,8"/>
                            <TextBlock x:Name="TxtUserCode"
                                       FontSize="40" FontWeight="Bold"
                                       Foreground="Orange"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,16"/>
                            <ProgressBar IsIndeterminate="True" Height="6"/>
                            <TextBlock Text="Waiting for authorization..."
                                       FontSize="13" Foreground="#AAAAAA"
                                       HorizontalAlignment="Center"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="TxtLoginStatus"
                               FontSize="14" TextWrapping="Wrap"
                               Foreground="#FF4444" Margin="0,4,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </PivotItem>

        <!-- ======== SYNC ======== -->
        <PivotItem Header="Sync">
            <ScrollViewer>
                <StackPanel Margin="12,0,12,24">
                    <TextBlock Text="Sync Contacts"
                               FontSize="22" FontWeight="Bold"
                               Margin="0,16,0,4"/>

                    <TextBlock x:Name="TxtAccountStatus"
                               FontSize="14" Foreground="#44AA44"
                               Margin="0,0,0,12"/>

                    <Button x:Name="BtnSync"
                            Content="Microsoft → Phone"
                            HorizontalAlignment="Stretch"
                            Height="72" FontSize="18"
                            IsEnabled="False"
                            Click="BtnSync_Click"
                            Margin="0,0,0,8"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnSignOut"
                                Grid.Column="0"
                                Content="Sign out"
                                Height="72" FontSize="18"
                                IsEnabled="False"
                                Click="BtnSignOut_Click"
                                Margin="0,0,4,0"/>
                        <Button x:Name="BtnEmailLog"
                                Grid.Column="1"
                                Content="Email log"
                                Height="72" FontSize="18"
                                Click="BtnEmailLog_Click"
                                Margin="4,0,0,0"/>
                    </Grid>

                    <TextBlock x:Name="TxtLastSync"
                               FontSize="12" Foreground="#888888"
                               Margin="0,0,0,8"
                               Visibility="Collapsed"/>
                </StackPanel>
            </ScrollViewer>
        </PivotItem>

        <!-- ======== LOG ======== -->
        <PivotItem Header="Log">
            <Grid Margin="12,8,12,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Button x:Name="BtnClearLog"
                        Grid.Row="0"
                        Content="Clear log"
                        HorizontalAlignment="Right"
                        Height="56" FontSize="14"
                        Click="BtnClearLog_Click"
                        Margin="0,0,0,4"/>

                <Border Grid.Row="1" Background="#111111" Padding="8">
                    <ScrollViewer x:Name="LogScroller">
                        <TextBlock x:Name="TxtLog"
                                   FontSize="13"
                                   FontFamily="Courier New"
                                   TextWrapping="Wrap"
                                   Foreground="#CCCCCC"/>
                    </ScrollViewer>
                </Border>
            </Grid>
        </PivotItem>

    </Pivot>
</Page>
